{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@receptionist/landing", "dev"],
      "port": 3100
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@receptionist/dashboard", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "apps/server", "uvicorn", "api.main:app", "--reload", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "api-8010",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "apps/server", "uvicorn", "api.main:app", "--port", "8010"],
      "port": 8010
    }
  ]
}
