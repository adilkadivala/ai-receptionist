# Copy to .env and fill in. Never commit .env.

# Public hostname Telnyx reaches this server on, without https:// (e.g. abc123.ngrok-free.app).
PUBLIC_HOST=
# Secret in the media-stream URL. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
MEDIA_STREAM_TOKEN=

TELNYX_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Optional if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# Database. The defaults in core/config.py point at the local dev database (infra/compose/dev.yml);
# set these only for staging and production. The app role must not be a superuser.
# DATABASE_URL=postgresql+psycopg://receptionist_app:...@host:5432/receptionist
# MIGRATION_DATABASE_URL=postgresql+psycopg://receptionist_owner:...@host:5432/receptionist

# Optional overrides (defaults in core/config.py).
# BUSINESS_NAME=Bright Pipes Plumbing
# A text file of the business's details (services, hours, area, prices, how booking works), relative to apps/server.
# Same shape as DEMO_BUSINESS_INFO in voice/prompt.py. Empty: that demo plumber.
# BUSINESS_INFO_FILE=businesses/my-business.md
# Add "this call may be recorded" to the AI notice. Only once calls are actually recorded.
# ANNOUNCE_RECORDING=false
# The languages callers mostly speak, English first: en,es for a US business, en,hi for an Indian one.
# CALLER_LANGUAGES=en,es
# Where the business is (US, CA, IN…): a caller's number without a country code is from here, and it's checked for
# length and read back in this country's groups.
# BUSINESS_COUNTRY=US
# The voice (a Cartesia voice ID) and its gender, which Hindi, Arabic and French grammar follow. A voice native to
# the callers' main language sounds most natural, and also speaks English in that accent.
# TTS_VOICE_ID=
# VOICE_GENDER=feminine
# TTS_VOICE_ID=
# MAX_CALL_SECONDS=600
